import numpy as np

# --- Raw Parameters from Table 1 (d=2) ---
NX, NS, NU = 41, 41, 31
T = 5
float_size = 8  # float64 = 8 bytes

# 1. Define the mandatory arrays for the backward induction
# These MUST exist in memory to calculate the result
v_current  = np.zeros((NX, NS), dtype=np.float64)  # Current Value Function
v_next     = np.zeros((NX, NS), dtype=np.float64)  # Value Function (Stage+1)
gap_cost   = np.zeros((NX, NS), dtype=np.float64)  # State-dependent costs
# Stored policy for each stage of the horizon (T=5)
policies   = [np.zeros((NX, NS), dtype=np.float64) for _ in range(T)]

# 2. Sum the bytes of every MANDATORY object
all_mandatory_objects = [v_current, v_next, gap_cost] + policies
total_raw_bytes = sum(obj.nbytes for obj in all_mandatory_objects)

# 3. Final Conversion
total_kB_decimal = total_raw_bytes / 1000  # Standard human "kB" (10^3)
total_KiB_binary  = total_raw_bytes / 1024  # Computer "KiB" (2^10)

print("="*60)
print("RAW EMPIRICAL DATA (PHYSICAL ALLOCATION)")
print("="*60)
print(f"Number of Full-Grid Arrays : {len(all_mandatory_objects)}")
print(f"Bytes per Array (41x41x8)  : {v_current.nbytes} bytes")
print(f"Total Physical Footprint   : {total_raw_bytes} bytes")
print(f"Empirical RAW Measurement  : {total_kB_decimal:.2f} kB")
print("-" * 60)
print(f"Theoretical (Table 1)      : 107.58 kB")
print(f"Error Margin               : {total_kB_decimal - 107.58:.4f} kB")
print("="*60)

