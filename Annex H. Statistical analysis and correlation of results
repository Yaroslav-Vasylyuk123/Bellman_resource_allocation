import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

dfA_out = pd.read_excel("bellman_outputs_base2048.xlsx", sheet_name="A", engine="openpyxl")

# Histogram of x5 (actually x6 from data)
plt.figure(figsize=(8,4))
plt.hist(dfA_out["x6"], bins=30) # Accessing 'x6' column
plt.title("Distribution of terminal readiness x5 (Sheet A)") # Labeling as 'x5'
plt.xlabel("x5") # Labeling as 'x5'
plt.ylabel("count")
plt.show()

# Scatter: x5 vs a (should show strong relationship if a is important)
